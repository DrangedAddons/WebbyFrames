<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- Our own options rows (WebbyFrames.lua), each its own template so the settings list keeps them in
         pools of their own; 26px tall like Blizzard's checkbox rows.
         CheckPair: two checkboxes side by side (B.pair). Swatch: a label and a colour swatch (B.swatch). -->
    <Frame name="WebbyFramesCheckPairTemplate" inherits="SettingsListElementTemplate" virtual="true">
        <Size x="280" y="26"/>
    </Frame>
    <Frame name="WebbyFramesSwatchTemplate" inherits="SettingsListElementTemplate" virtual="true">
        <Size x="280" y="26"/>
    </Frame>
</Ui>
